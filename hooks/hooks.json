{
  "description": "Babysit release checks and session tracking (Claude Code, Codex, Grok Build). OMP uses hooks/omp.ts.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bbs hooks pre-tool-gate", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bbs hooks session-writer", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bbs hooks session-writer", "timeout": 10 }
        ]
      }
    ]
  }
}
